<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <Button
        android:text="Salvar"
        android:layout_width="match_parent"
        android:id="@+id/salvar_frequencia"
        android:textStyle="normal|bold"
        android:textColor="@android:color/background_light"
        android:layout_gravity="bottom"
        android:layout_marginStart="-5dip"
        android:layout_marginEnd="-5dip"
        android:layout_marginBottom="-7dip"
        android:layout_marginLeft="-5dip"
        android:layout_marginRight="-5dip"
        android:layout_marginTop="-5dip"
        android:layout_height="70dp"
        android:padding="0dp"
        android:layout_alignParentBottom="true"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_above="@+id/salvar_frequencia">

        <android.support.design.widget.AppBarLayout
            android:id="@+id/appbar"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:theme="@style/Base.Widget.AppCompat.ActionBar"
            app:titleTextColor="@color/cardview_dark_background">

            <android.support.design.widget.CollapsingToolbarLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:toolbarId="@+id/lancar_frequencia_toolbar"
                app:layout_scrollFlags="scroll|exitUntilCollapsed"
                app:titleEnabled="false">

                <android.support.v7.widget.Toolbar
                    android:id="@+id/lancar_frequencia_toolbar"
                    android:layout_height="?attr/actionBarSize"
                    android:layout_width="match_parent"
                    android:theme="@style/Base.Widget.AppCompat.ActionBar"
                    app:titleTextColor="@color/cardview_dark_background"
                    app:titleTextAppearance="@style/titleAppBar"
                    />
            </android.support.design.widget.CollapsingToolbarLayout>
        </android.support.design.widget.AppBarLayout>


        <android.support.v4.widget.NestedScrollView
            android:id="@+id/activity_lancar_frequencia_nested_scroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="-5dip"
            android:layout_marginEnd="-5dip"
            android:padding="0dp">

            <LinearLayout
                android:id="@+id/activity_lancar_frequencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp"
                android:descendantFocusability="blocksDescendants"
                tools:context="br.ueg.mobile.exitus.visao.LancarFrequenciaActivity">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView9"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="10dp"
                            android:text="Curso:"
                            android:textSize="18sp"
                            android:textStyle="normal|bold" />

                        <TextView
                            android:id="@+id/txtView_curso_nome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="10dp"
                            android:text="Nome do cursoVisao"
                            android:textSize="18sp"
                            android:textStyle="normal|bold" />


                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/textView10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="10dp"
                            android:text="Disciplina:"
                            android:textSize="18sp"
                            android:textStyle="normal|bold" />

                        <TextView
                            android:id="@+id/txtView_disciplina_nome"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:padding="10dp"

                            android:text="Nome da Disciplina"
                            android:textSize="18sp"
                            android:textStyle="normal|bold" />

                        <ImageView
                            android:id="@+id/activity_lancar_frequencia_imageView_status"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="7dp"
                            android:layout_marginBottom="2dp"
                            android:padding="7dp"
                            app:srcCompat="@android:drawable/ic_lock_lock" />
                    </LinearLayout>
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/root_numero_aulas"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:background="#D9D9D9"
                    android:orientation="horizontal">

                    <!--<TextView-->
                    <!--android:text="1º"-->
                    <!--android:layout_width="wrap_content"-->
                    <!--android:layout_height="wrap_content"-->
                    <!--android:id="@+id/textView12"-->
                    <!--android:layout_marginLeft="20px" />-->

                    <!--<TextView-->
                    <!--android:text="2º"-->
                    <!--android:layout_width="wrap_content"-->
                    <!--android:layout_height="wrap_content"-->
                    <!--android:id="@+id/textView11"-->
                    <!--android:layout_marginLeft="60px" />-->
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/root_aluno_list_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="10dp"
                    android:orientation="vertical">

                    <include layout="@layout/layout_aluno_card_view" />
                </LinearLayout>
            </LinearLayout>
        </android.support.v4.widget.NestedScrollView>
    </LinearLayout>
</RelativeLayout>
